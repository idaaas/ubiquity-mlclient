VERSION 0.8

ARG --global --required os

SWIG_INSTALL:
  FUNCTION
  IF echo $os | grep -q ubuntu
    IF [ "$os" = "ubuntu:16.04" ]
      RUN wget --quiet https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.gz > /dev/null && tar xzf bison-3.8.2.tar.gz > /dev/null
      RUN apt-get install --no-install-recommends -qq m4 automake libz-dev libpcre2-dev > /dev/null
      RUN cd bison-3.8.2 && ./configure > /dev/null && make > /dev/null && make install > /dev/null && cd .. && rm -rf bison-3.8.2*
    ELSE
      RUN apt-get install --no-install-recommends -qq automake bison libz-dev libpcre2-dev > /dev/null
    END
    GIT CLONE --branch v4.3.0 https://github.com/swig/swig /swig
    RUN cd /swig && ./autogen.sh > /dev/null && ./configure > /dev/null && make -j $(nproc) > /dev/null && make install > /dev/null && rm -rf /swig
  END