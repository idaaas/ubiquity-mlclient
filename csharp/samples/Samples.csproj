<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<AssemblyName>example1</AssemblyName>
		<OutputPath>bin/line-item/</OutputPath>
		<RootNamespace>ai.ubiquity.samples</RootNamespace>
		<StartupObject>ai.ubiquity.samples.lineitem.Example1</StartupObject>

		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

  <PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<AssemblyName>example1</AssemblyName>
		<OutputPath>bin/bid-shading/</OutputPath>
		<RootNamespace>ai.ubiquity.samples</RootNamespace>
		<StartupObject>ai.ubiquity.samples.bidshading.Example1</StartupObject>

		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

  <ItemGroup>
		<Compile Include="common/apiUtil.cs" />
		<Compile Include="line-item/example1.cs" />
    <Compile Include="bid-shading/example1.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="UbiquityMlClient"/>
	</ItemGroup>
</Project>
