VERSION 0.8
FROM busybox

ARG --global --required os
ARG --global type=Release
ARG --global disableIdChecks=OFF

base-image:
  LET supportedOs=ubuntu:16.04 ubuntu:20.04 ubuntu:22.04 ubuntu:24.04
  IF echo $supportedOs | grep -q $os
    FROM $os
  ELSE
    RUN printf "%s is not supported. Valide choices are: %s\n" $os "$supportedOs"; false
  END
  IF echo $os | grep -q ubuntu
    ENV DEBIAN_FRONTEND noninteractive
    ENV DEBCONF_NONINTERACTIVE_SEEN true
    RUN apt-get update -qq > /dev/null
    IF [ "$os" = "ubuntu:16.04" ]
      RUN apt-get install --no-install-recommends -qq software-properties-common > /dev/null \
        && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
        && apt-get update -qq > /dev/null
      RUN apt-get install --no-install-recommends -qq libstdc++-9-dev > /dev/null
    END
    # tools
    RUN apt-get install --no-install-recommends -qq wget ca-certificates libssl-dev > /dev/null
    # project deps
    RUN apt-get install --no-install-recommends -qq libbsd-dev uuid-dev libcurl4-openssl-dev > /dev/null
    RUN apt-get clean > /dev/null
  END
  WORKDIR /client

cmake-image:
  FROM +base-image
  IF echo $os | grep -q ubuntu
    IF [ "$os" = "ubuntu:16.04" ]
      RUN apt-get install --no-install-recommends -qq software-properties-common > /dev/null && add-apt-repository -y ppa:ubuntu-toolchain-r/test && apt-get update -qq > /dev/null
      RUN apt-get install --no-install-recommends -qq build-essential g++-9 git doxygen > /dev/null
      RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 10 > /dev/null
      RUN update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 10 > /dev/null
      RUN update-alternatives --install /usr/bin/cc cc /usr/bin/gcc 30 > /dev/null
      RUN update-alternatives --set cc /usr/bin/gcc > /dev/null
      RUN update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++ 30 > /dev/null
      RUN update-alternatives --set c++ /usr/bin/g++ > /dev/null
    ELSE
      RUN apt-get install --no-install-recommends -qq build-essential g++ git doxygen > /dev/null && apt-get clean
    END
    RUN wget --quiet https://github.com/Kitware/CMake/releases/download/v3.30.2/cmake-3.30.2-linux-x86_64.sh > /dev/null
    RUN sh cmake-3.30.2-linux-x86_64.sh --skip-license --prefix=/usr/local/ > /dev/null && rm cmake-3.30.2-linux-x86_64.sh
  END

build:
  FROM +cmake-image
  CACHE ./build/_deps
  COPY --keep-ts --dir docs src tests include packaging CMakeLists.txt .
  RUN cmake -DCMAKE_VERBOSE_MAKEFILE:BOOL=OFF -DBUILD_AERON_ARCHIVE_API=OFF -DBUILD_TESTING=ON -DCMAKE_BUILD_TYPE=$type -DDISABLE_ID_CHECKS=$disableIdChecks -DGIT_HASH=#ghashit -S . -B build
  RUN cmake --build build --parallel $(nproc) --target ubiquity_client_static docs
  RUN cmake --build build --parallel $(nproc) --target test_connection
  RUN cmake --build build --parallel $(nproc) --target test_node_client
  RUN cmake --build build --parallel $(nproc) --target test_synchronizer
  RUN cmake --build build --parallel $(nproc) --target test_shared_state_store
  RUN cmake --build build --parallel $(nproc) --target test_cluster_client
  RUN cmake --build build --parallel $(nproc) --target test_client_handle
  RUN cmake --build build --parallel $(nproc) --target test_load_balancer
  ARG EARTHLY_GIT_SHORT_HASH # used to put HASH in the driver build (call before use, to be able to cache base images)
  IF [ -n "$EARTHLY_GIT_SHORT_HASH" ]
    RUN echo "Using EARTHLY_GIT_SHORT_HASH: $EARTHLY_GIT_SHORT_HASH"
    ENV HASH=$EARTHLY_GIT_SHORT_HASH
  ELSE
    RUN echo "EARTHLY_GIT_SHORT_HASH not set, using 'aaaabbbb'"
    ENV HASH=aaaabbbb
  END
  RUN sed -i "s/#ghashit/$HASH/g" build/src/libubiquity_client_static.a
  RUN sed -i "s/#ghashit/$EARTHLY_GIT_SHORT_HASH/g" build/src/libubiquity_client_static.a
  RUN build/tests/connection/test_connection
  RUN build/tests/node_client/test_node_client
  RUN build/tests/synchronizer/test_synchronizer
  RUN build/tests/shared_state_store/test_shared_state_store
  RUN build/tests/cluster_client/test_cluster_client
  RUN build/tests/client_handle/test_client_handle
  RUN build/tests/load_balancer/test_load_balancer
  SAVE ARTIFACT build/src/libubiquity_client_static.a
  SAVE ARTIFACT include/ubiquity_client/Ubiquity.hpp

bindings:
  COPY --dir +build/* local-output/
  SAVE ARTIFACT local-output/*

examples:
  ARG latest=false
  ARG imagePrefix
  ARG imageSuffix=latest
  FROM +cmake-image
  CACHE ./build/_deps
  COPY --keep-ts --dir docs src tests include packaging CMakeLists.txt samples .
  RUN cmake -DCMAKE_VERBOSE_MAKEFILE:BOOL=OFF -DBUILD_AERON_ARCHIVE_API=OFF -DBUILD_SAMPLES=ON -DCMAKE_BUILD_TYPE=$type -DGIT_HASH=#ghashit -DDISABLE_ID_CHECKS=$disableIdChecks -S . -B build
  RUN cmake --build build --parallel $(nproc) --target line-item probability-estimator action-rate
  ARG EARTHLY_GIT_SHORT_HASH # used to put HASH in the driver build (call before use, to be able to cache base images)
  IF [ -n "$EARTHLY_GIT_SHORT_HASH" ]
    RUN echo "Using EARTHLY_GIT_SHORT_HASH: $EARTHLY_GIT_SHORT_HASH"
    ENV HASH=$EARTHLY_GIT_SHORT_HASH
  ELSE
    RUN echo "EARTHLY_GIT_SHORT_HASH not set, using 'aaaabbbb'"
    ENV HASH=aaaabbbb
  END
  FOR file IN $(find ./build/samples -type f)
    RUN sed -i "s/#ghashit/$HASH/g" $file
  END
  RUN cp -r ./build/samples/* .
  WAIT
    COPY ../datasets/+files/ datasets
    SAVE IMAGE --push ${imagePrefix}cpp-examples:${imageSuffix}
    IF [ "$latest" = "true" ]
      SAVE IMAGE --push ${imagePrefix}cpp-examples:latest
    END
  END
