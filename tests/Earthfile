VERSION 0.8
FROM ubuntu:22.04

ARG --global debug=false

publish-ubiquity-mlclient:
    FROM hseeberger/scala-sbt:17.0.2_1.6.2_2.13.8
    COPY (../+java-bindings/ubiquity-mlclient.jar --type=DEBUG --os=ubuntu:22.04)  build/bin/ubiquity-mlclient.jar
    SAVE ARTIFACT build/bin/ubiquity-mlclient.jar AS LOCAL integration/lib/ubiquity-mlclient.jar

build-integration-tests:
    FROM hseeberger/scala-sbt:17.0.2_1.6.2_2.13.8
    WORKDIR /tests
    COPY (../+java-bindings/ubiquity-mlclient.jar --type=DEBUG --os=ubuntu:22.04)  build/bin/ubiquity-mlclient.jar
    COPY integration/project/plugins.sbt integration/project/
    COPY integration/*.sbt integration/
    COPY integration/src integration/src/
    # compile sources
    WORKDIR integration
    RUN sbt compile
    RUN sbt assembly
    #RUN sbt testJar
    SAVE ARTIFACT target/assembly.jar build/bin/integration-tests.jar AS LOCAL build/bin/integration-tests.jar
    #SAVE ARTIFACT target/integration-assert.jar build/bin/integration-assert.jar AS LOCAL build/bin/integration-assert.jar

run-scenario:
    ARG scenario
    FROM ../+java-swig-image --os=ubuntu:22.04
    ENV DOCKER_BUILDKIT 0
    ENV COMPOSE_DOCKER_CLI_BUILD 0
    DO github.com/earthly/lib+INSTALL_DIND
    COPY +build-integration-tests/build/bin/integration-tests.jar build/
    COPY integration/src/main/java/ai/ubiquity/integration/tests/$scenario/application.json build/
    COPY integration/docker-compose.yml .
    RUN echo "SCENARIO=$scenario" > .env
    RUN echo "OUTPUT=it-$scenario.log" >> .env
    WITH DOCKER --allow-privileged --compose docker-compose.yml
         RUN --no-cache --mount=type=tmpfs,target=/dev/shm timeout 60s java -classpath build/integration-tests.jar -Dconfig.file=build/application.json  ai.ubiquity.integration.tests.$scenario.Client > build/client-$scenario.log || \
            echo "Process timed out"
    END
    RUN --no-cache [ "$debug" = "true" ] && cat build/client-$scenario.log || true
    RUN --no-cache [ "$debug" = "true" ] && cat build/it-$scenario.log || true
    SAVE ARTIFACT build/client-$scenario.log AS LOCAL integration/src/test/resources/testOutput/client-$scenario.log
    SAVE ARTIFACT build/it-$scenario.log AS LOCAL integration/src/test/resources/testOutput/it-$scenario.log

test-all:
  FROM hseeberger/scala-sbt:17.0.2_1.6.2_2.13.8
  COPY (../+java-bindings/ubiquity-mlclient.jar --type=DEBUG --os=ubuntu:22.04)  build/bin/ubiquity-mlclient.jar
  COPY integration/project/plugins.sbt integration/project/
  COPY integration/*.sbt integration/
  COPY integration/src integration/src/
  WORKDIR integration
  FOR i IN $(seq 1 6)
    RUN echo "running test scenario$i..."
    COPY (+run-scenario/it-scenario$i.log --scenario=scenario$i) (+run-scenario/client-scenario$i.log --scenario=scenario$i) src/test/resources/testOutput/
    RUN echo "test finished"
  END
  RUN sbt test


